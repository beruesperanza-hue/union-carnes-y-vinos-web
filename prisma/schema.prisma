generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reservation {
  id          String   @id @default(cuid())
  nombre      String
  apellido    String
  email       String
  telefono    String
  personas    Int
  fecha       DateTime
  hora        String
  ubicacion   String   @default("adentro")
  comentarios String?
  estado      String   @default("confirmada")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fecha, hora, email])
  @@index([fecha])
  @@index([estado])
}

model Schedule {
  id               String   @id @default(cuid())
  dia              String
  hora             String
  capacidad        Int      @default(30)
  capacidadVereda  Int      @default(0)
  activo           Boolean  @default(true)
  cerradoManual    Boolean  @default(false)
  cerradoVereda    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([dia, hora])
  @@index([dia])
}

// Cierres puntuales por fecha (feriados, eventos privados, lluvia en la terraza).
// A diferencia de Schedule.cerradoManual/cerradoVereda (que afectan ese horario
// TODAS las semanas), un Cierre vale solo para su fecha.
//   hora   = ""  → todo el día · "20:30" → solo ese turno
//   sector = "todos" | "adentro" | "vereda"
// `hora` es "" y no NULL para que el unique funcione (en Postgres los NULL
// nunca chocan entre sí).
model Cierre {
  id        String   @id @default(cuid())
  fecha     DateTime
  hora      String   @default("")
  sector    String   @default("todos")
  motivo    String?
  createdAt DateTime @default(now())

  @@unique([fecha, hora, sector])
  @@index([fecha])
}

// Turnos que existen solo en una fecha concreta (día especial: abrir un lunes
// para un evento, sumar un almuerzo, horario de Nochevieja). Se combinan con los
// turnos semanales de Schedule; ver lib/turnos.ts.
//   - Si la fecha ya tiene un turno semanal a esa `hora`, este lo REEMPLAZA
//     para esa fecha (sirve para cambiar la capacidad de un día).
//   - `reemplaza` = true → ese día usa SOLO sus turnos especiales y se ignoran
//     los semanales. Es una propiedad de la fecha, repetida en todas sus filas
//     (así, al borrar las filas, el modo desaparece solo).
model TurnoEspecial {
  id              String   @id @default(cuid())
  fecha           DateTime
  hora            String
  capacidad       Int      @default(30)
  capacidadVereda Int      @default(0)
  reemplaza       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([fecha, hora])
  @@index([fecha])
}

model Settings {
  id                    String   @id @default(cuid())
  nombreRestaurante     String   @default("Unión Carnes y Vinos")
  emailRestaurante      String   @default("barunionruzafa@gmail.com")
  telefonoRestaurante   String   @default("+34 619 24 04 02")
  direccionRestaurante  String   @default("Carrer de Puerto Rico, 38, Valencia")
  capacidadPorTurno     Int      @default(30)
  diasAvanzados         Int      @default(60)
  mensajeConfirmacion   String   @default("¡Gracias! Tu reserva fue realizada correctamente.")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  email     String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
